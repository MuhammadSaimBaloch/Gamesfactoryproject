{
  "name": "games-factory-pakistan",
  "private": true,
  "type": "module",
  "scripts": {
    "images:optimize": "node scripts/optimize-images.mjs",
    "dev": "node scripts/optimize-images.mjs && react-router dev --host 127.0.0.1",
    "build": "node scripts/optimize-images.mjs && react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=db/seed.sql",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@radix-ui/react-dialog": "latest",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "latest",
    "drizzle-orm": "latest",
    "image-size": "^2.0.4",
    "isbot": "latest",
    "jose": "latest",
    "lucide-react": "latest",
    "motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "8.4.0",
    "tailwindcss": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
